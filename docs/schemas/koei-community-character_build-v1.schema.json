{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Koei Tecmo Community Character Build v1",
  "description": "A data-only community package. Runtime validation also checks JSON duplicate keys, byte/depth limits, and cross-record references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "kind",
    "id",
    "title",
    "author",
    "game_id",
    "platform",
    "game_version",
    "description",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "koei-tecmo-community-package"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "const": "character_build"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "$ref": "#/$defs/title_text"
    },
    "author": {
      "$ref": "#/$defs/author_text"
    },
    "game_id": {
      "$ref": "#/$defs/game_id"
    },
    "platform": {
      "anyOf": [
        {
          "$ref": "#/$defs/platform_id"
        },
        {
          "const": "any"
        }
      ]
    },
    "game_version": {
      "oneOf": [
        {
          "$ref": "#/$defs/version_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "level": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "$ref": "#/$defs/identifier"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  {
                    "type": "integer",
                    "minimum": -9223372036854775808,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "required": [
              "key",
              "value"
            ]
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "rank": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              }
            },
            "required": [
              "id",
              "rank"
            ]
          }
        },
        "equipment": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              }
            },
            "required": [
              "slot",
              "id"
            ]
          }
        }
      },
      "required": [
        "character_id",
        "level",
        "stats",
        "skills",
        "equipment"
      ],
      "anyOf": [
        {
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        },
        {
          "required": [
            "stats"
          ],
          "properties": {
            "stats": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "skills"
          ],
          "properties": {
            "skills": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "equipment"
          ],
          "properties": {
            "equipment": {
              "minItems": 1
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "title_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "author_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "game_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "platform_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    }
  },
  "$comment": "The runtime reader enforces a 1 MiB UTF-8 JSON byte limit, duplicate-key rejection, control-character checks, and the documented uniqueness and cross-reference rules."
}
